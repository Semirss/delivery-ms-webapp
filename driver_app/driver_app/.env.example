# ============================================================
# MOTOBIKE DRIVER App - Environment Configuration
# ============================================================
# Copy this file to .env, fill in test values, and build with
# --dart-define-from-file=.env. The file is not bundled as an asset.
# NEVER commit the .env file to version control!
# ============================================================

# --- Supabase (REQUIRED) ---
SUPABASE_URL=https://your-test-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --- App ---
ENVIRONMENT=test
APP_NAME=MOTOBIKE Driver

# --- Web API (REQUIRED for admin-controlled app version checks) ---
# Use the deployed webapp URL. Local example: http://localhost:3000
API_BASE_URL=https://your-test-webapp-domain.com
API_TIMEOUT=30000

# --- Monitoring (Optional) ---
# Leave blank unless you have a real Sentry project DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=test

# --- Feature Flags ---
ENABLE_LOGGING=true
ENABLE_CHUCK_INTERCEPTOR=true
