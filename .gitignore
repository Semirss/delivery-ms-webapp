# Root .gitignore for the monorepo

# Environment variables - NEVER commit these
webapp/.env.local
webapp/.env
telegram-bot/.env
**/.env.local
**/.env

# Android release signing secrets - NEVER commit these
**/android/key.properties
**/android/app/upload-keystore.jks
**/*.jks
**/*.keystore

# Apple release signing secrets - NEVER commit these
ios_distribution_private_key.pem
**/*.p8
**/*.p8c
**/*.p12
**/*.mobileprovision

# Dependency directories
.tools/
**/node_modules/
**/__pycache__/
**/*.pyc
**/venv/
**/.venv/

# Build outputs
webapp/.next/
webapp/out/

# Misc
.DS_Store
*.log
Thumbs.db
